rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理员账号：好友码 QS-7JFFYV 在 codes 里登记的那个 uid
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/codes/QS-7JFFYV)
        && get(/databases/$(database)/documents/codes/QS-7JFFYV).data.uid == request.auth.uid;
    }

    // 好友码 → 云端身份（谁都能读，用来加好友；只能本人登记/更新自己的码）
    match /codes/{code} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // 自己的账号资料
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 好友关系（双向）：谁加谁都会写一条，两边都能读
    match /links/{lid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create, update: if request.auth != null && request.auth.uid in request.resource.data.members;
    }

    // 礼物邮箱：发件人能发、双方能看，只有收件人能改状态
    match /gifts/{gid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.toUid
                    && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }

    // 两个人之间的会话：只有这两个账号能读和发
    match /chats/{chatId}/msgs/{msgId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update, delete: if false;
    }

    // 社区帖子满 7 天后允许任何已登录玩家清理（只删已过期，删不了有效期内的帖子）
    function isExpiredPost() {
      return resource.data.createdAt is number
             && resource.data.createdAt + 604800000 <= request.time.seconds * 1000;
    }

    // ===== 社区（公开） =====
    // 所有玩家都能看帖、看评论；帖子作者能改内容/删帖；
    // 其他人只能改 likedBy（点赞）；到期的帖子允许自动清理
    match /posts/{pid} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        isAdmin() ||
        isExpiredPost()
      );

      match /comments/{cid} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
        allow update: if false;
      }
    }

    // 玩家自制衣服的原图（帖子只存 id，买家买下时从这里取图）
    match /items/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // 自制衣服交易：只有买卖双方能看和改
    match /trades/{tid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.sellerUid != request.auth.uid;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if false;
    }

    // 反馈箱：谁都能提交；只有管理员能读和回复
    match /feedback/{fid} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 500;
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['reply', 'repliedAt', 'status']);
      allow delete: if false;
    }

    // 云存档：只有本人能读写自己的存档和分块
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /chunks/{cid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 公告板：所有玩家可看，只有管理员能发/改/删
    match /announcements/{aid} {
      allow read: if true;
      allow create: if isAdmin()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 40
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 1000;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['title', 'content', 'pinned', 'updatedAt']);
      allow delete: if isAdmin();
    }
  }
}
